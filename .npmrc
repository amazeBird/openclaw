# pnpm v11 reads project settings from pnpm-workspace.yaml.
# Keep this file for registry/auth-only npmrc entries so Docker COPY steps stay stable.
registry=https://registry.npmjs.org/
# TS 7 native-preview fails to resolve packages reliably from pnpm's isolated linker.
# Keep the workspace on a hoisted layout so pnpm check/build stay stable.
node-linker=hoisted
# Windows without Developer Mode cannot create symlinks; avoid EPERM/EISDIR during workspace links.
# pnpm v11 applies this from pnpm-workspace.yaml (`symlink: false`); keep in sync here for tools that only read .npmrc.
symlink=false
# Non-interactive / agent installs: allow pnpm to reconcile node_modules without a TTY (pnpm 11).
confirm-modules-purge=false
